PORT=5000
NODE_ENV=production

# MongoDB Connection (use Atlas M10+ or M0 with retryWrites=true)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/banoqabil_lms?retryWrites=true&w=majority

# Authentication
JWT_SECRET=replace_with_a_64_char_random_secret

# Allowed Frontend Origins (comma-separated if multiple)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# Student Portal Login Link (included in bulk credential emails)
STUDENT_PORTAL_URL=https://your-frontend-domain.vercel.app

# Email Option 1: Resend HTTP API (recommended for Vercel serverless)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=BanoQabil LMS <noreply@yourdomain.com>

# Email Option 2: Nodemailer SMTP (used if RESEND_API_KEY is not set)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_email@gmail.com
SMTP_PASS=your_app_specific_password

# Cloudinary Storage (Assignments & Lecture Notes)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
